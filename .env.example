TTS_API_KEY=replace-with-a-random-secret-at-least-32-characters-long
TTS_BIND_IP=10.2.1.150
TTS_PORT=8070
TTS_GPU_ID=0
# Validated RTX 5090 / CUDA 12.8 acceleration; none selects the baseline.
TTS_ACCELERATION=flashinfer
# Bounded, exact-shape graphs in speech workers; parent profile/ASR model stays eager.
TTS_FLASHINFER_GRAPHS=1
# Compose mounts the validated, checkpoint-specific TensorRT production artifacts.
TTS_TENSORRT_PLAN=/models/tensorrt/forward.plan
TTS_TENSORRT_MANIFEST=/models/tensorrt/manifest.json
TTS_FLASHINFER_CUDA_ARCH_LIST=12.0a
FLASHINFER_USE_CUDA_NORM=1
TTS_MODEL_ID=k2-fsa/OmniVoice
TTS_MODEL_REVISION=c5fdb5ccb189668d56333f77ba2629f4cd7535f4
# Optional administrator ceilings. Zero leaves content size unrestricted.
TTS_MAX_TEXT_CHARS=0
TTS_MAX_BODY_BYTES=0
TTS_MAX_AUDIO_BYTES=0
# Durable speech queue and completed WAVs, on persistent writable storage.
TTS_JOBS_DIR=/data/jobs
# Requested speech processes (1-4); startup may reduce this for RAM/GPU reserve.
# Verify actual GPU capacity before increasing it; /v1/audio/jobs reports the effective count.
TTS_PARALLEL_WORKERS=2
# No automatic deletion. Set a positive number only for deliberate expiry.
TTS_JOB_RETENTION_SECONDS=0
# Waiting administration/model operations only; not a speech-job count limit.
# Speech admission instead reserves disk space for all outstanding results.
TTS_QUEUE_SIZE=0
# Speech execution timeout after a worker starts; queue waiting is not counted.
TTS_REQUEST_TIMEOUT=0
# Optional comma-separated browser origins, for example https://your-app.example
TTS_CORS_ORIGINS=
